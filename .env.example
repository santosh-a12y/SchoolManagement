# ==============================================================================
# STUDENT MANAGEMENT SYSTEM — ENVIRONMENT CONFIGURATION
# Copy this file to .env.local for local overrides.
# When these variables are empty, the application runs automatically in
# Offline / Local Demo Mode backed by server-side persistent JSON storage.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Sheets & Drive API Integration (Optional for Cloud Mode)
# ------------------------------------------------------------------------------
# Service Account Email created in Google Cloud Console
GOOGLE_SERVICE_ACCOUNT_EMAIL="your-service-account@your-project-id.iam.gserviceaccount.com"

# Service Account Private Key (keep newlines as \n in env string)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQD...\n-----END PRIVATE KEY-----\n"

# The Google Spreadsheet ID from your browser URL:
# https://docs.google.com/spreadsheets/d/{GOOGLE_SHEET_ID}/edit
GOOGLE_SHEET_ID="1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgvE2upms"

# Optional: Google Drive Folder ID for storing uploaded student photos
# If omitted or offline, photos are stored locally in public/uploads/
GOOGLE_DRIVE_FOLDER_ID=""

# ------------------------------------------------------------------------------
# 2. Application & Session Settings
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Oxford School"
NEXT_PUBLIC_DEFAULT_SESSION="2026-27"
NODE_ENV="development"
